{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canview:cvota:v2:manifest-json",
  "title": "CANView OTA v2 manifest 작성 입력",
  "description": "packager용 JSON 표현이다. wire는 integer-key canonical CBOR이며 package_id/sha256 hex는 CBOR byte string으로 변환한다. 인증·image 검증·설치 승인을 뜻하지 않는다. u64는 Python 정수로 보존하며 JavaScript Number로 왕복하지 않는다.",
  "$comment": "ABI 범위 순서, snapshot 포함, ABI 조합 포함, target 중복과 image 길이/총길이의 교차 제약은 tools/ota/manifest.py 및 C 검사기로 추가 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "package_id", "role", "board_revision", "layout_id", "release", "security_epoch", "key_id", "images", "compatibility", "config_schema", "requires"],
  "properties": {
    "format_version": {"const": 2, "x-cbor-key": 0},
    "package_id": {"type": "string", "pattern": "^[0-9a-f]{32}(?![\\s\\S])", "x-cbor-key": 1, "x-cbor-hex": true},
    "role": {"type": "integer", "enum": [1, 2, 3], "x-cbor-key": 2},
    "board_revision": {"$ref": "#/$defs/text", "x-cbor-key": 3},
    "layout_id": {"$ref": "#/$defs/text", "x-cbor-key": 4},
    "release": {"$ref": "#/$defs/text", "x-cbor-key": 5},
    "security_epoch": {"$ref": "#/$defs/u32", "x-cbor-key": 6},
    "key_id": {"$ref": "#/$defs/u32", "x-cbor-key": 7},
    "images": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/image"}, "x-cbor-key": 8},
    "compatibility": {"$ref": "#/$defs/compatibility", "x-cbor-key": 9},
    "config_schema": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/u32"}, "x-cbor-key": 10},
    "requires": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/u32"}, {"$ref": "#/$defs/u32"}, {"$ref": "#/$defs/u64"}], "items": false, "x-cbor-key": 11}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[ -~]+(?![\\s\\S])"},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/u32"}},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "length", "sha256", "version", "release_sequence", "signature", "abi"],
      "properties": {
        "target": {"type": "integer", "enum": [1, 2, 3, 4], "x-cbor-key": 0},
        "length": {"type": "integer", "minimum": 1, "maximum": 4194304, "x-cbor-key": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "x-cbor-key": 2, "x-cbor-hex": true},
        "version": {"$ref": "#/$defs/text", "x-cbor-key": 3},
        "release_sequence": {"$ref": "#/$defs/u64", "x-cbor-key": 4},
        "signature": {"type": "integer", "enum": [1, 2], "x-cbor-key": 5},
        "abi": {"$ref": "#/$defs/u32", "x-cbor-key": 6}
      },
      "allOf": [
        {"if": {"properties": {"target": {"const": 2}}}, "then": {"properties": {"length": {"maximum": 184320}, "signature": {"const": 2}}}, "else": {"properties": {"signature": {"const": 1}}}},
        {"if": {"properties": {"target": {"const": 4}}}, "then": {"properties": {"length": {"maximum": 2621440}}}}
      ]
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["esp", "stm", "peer", "allowed_pairs"],
      "properties": {
        "esp": {"$ref": "#/$defs/range", "x-cbor-key": 0},
        "stm": {"$ref": "#/$defs/range", "x-cbor-key": 1},
        "peer": {"$ref": "#/$defs/range", "x-cbor-key": 2},
        "allowed_pairs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/range"}, "x-cbor-key": 3}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"role": {"const": 1}}}, "then": {"properties": {"images": {"items": {"properties": {"target": {"enum": [1, 2]}}}}, "compatibility": {"properties": {"allowed_pairs": {"minItems": 1}}}}}},
    {"if": {"properties": {"role": {"const": 2}}}, "then": {"properties": {"images": {"maxItems": 1, "items": {"properties": {"target": {"const": 3}}}}, "compatibility": {"properties": {"allowed_pairs": {"maxItems": 0}}}}}},
    {"if": {"properties": {"role": {"const": 3}}}, "then": {"properties": {"images": {"maxItems": 1, "items": {"properties": {"target": {"const": 4}}}}, "compatibility": {"properties": {"allowed_pairs": {"maxItems": 0}}}}}}
  ]
}
