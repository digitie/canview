{
  "revision": "R1-review",
  "board": "bridge",
  "sheets": {
    "01_usb_c": "USB-C sink: requires CC advertisement >=1.5A. Default-current ports DO NOT power the board. No USB PD/high-voltage request.",
    "01b_usb_limit": "USB load current limit about1A, below the minimum1.5A CC advertisement. Input<=6.5V; no PD sink negotiation.",
    "02_system_power": "Bridge USB-only3.3V buck. No CAN transceiver or vehicle-control output on this board.",
    "03_reset": "MCU supervisor3.08V with130..270ms release. Communicator also has an independent PHY-domain supervisor.",
    "02_esp32": "ESP32-S3-WROOM-1. Keep antenna clearance. USB native serial/JTAG. PSRAM pins reserved.",
    "03_service": "BOOT button for ROM download. Reset supervisor is shared on Communicator. Keep GPIO0 released for normal boot."
  },
