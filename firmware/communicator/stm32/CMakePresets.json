{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "STM32CUBE_G4_ROOT": "$env{STM32CUBE_G4_ROOT}",
        "CMAKE_MAKE_PROGRAM": "$env{CANVIEW_NINJA_EXECUTABLE}"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "STM32G474CEU6 Debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "primary-debug",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/primary-debug",
      "cacheVariables": {"CANVIEW_STM_IMAGE_LAYOUT": "MCUBOOT_PRIMARY"}
    },
    {
      "name": "primary-release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/primary-release",
      "cacheVariables": {"CANVIEW_STM_IMAGE_LAYOUT": "MCUBOOT_PRIMARY"}
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "STM32G474CEU6 Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "primary-debug",
      "configurePreset": "primary-debug"
    },
    {
      "name": "primary-release",
      "configurePreset": "primary-release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
